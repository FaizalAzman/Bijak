{
  "expo": {
    "name": "Bijak",
    "slug": "bijak",
    "scheme": "bijak",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bijak.app"
    },
    "android": {
      "package": "com.bijak.app",
      "adaptiveIcon": {
        "backgroundColor": "#FDF6E9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#FDF6E9"
        }
      ],
      "expo-audio",
      "expo-sqlite",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#F26B3A"
        }
      ],
      "expo-localization",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
